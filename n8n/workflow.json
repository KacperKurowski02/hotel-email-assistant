    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.content ?? []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet s;\ntry {\n  s = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n} catch (e) {\n  s = {\n    tresc_html: '<p>' + raw.replace(/\\n/g, '<br>') + '</p>',\n    braki: ['Claude nie zwrócił JSON – przeczytaj szkic uważnie'],\n    pewnosc: 'niska'\n  };\n}\n\nconst mail = $('Parsuj klasyfikację').first().json;\nconst temat = /^re:/i.test(mail.temat) ? mail.temat : 'Re: ' + mail.temat;\nconst html = s.tresc_html ?? '';\n\n// Wiadomość w formacie MIME z nagłówkami odpowiedzi\nconst zakoduj = (t) => '=?UTF-8?B?' + Buffer.from(t, 'utf8').toString('base64') + '?=';\nconst poprzednie = Array.isArray(mail.references) ? mail.references : (mail.references ? [mail.references] : []);\nconst references = [...poprzednie, mail.rfcMessageId].filter(Boolean).join(' ');\nconst mime = [\n  `To: ${mail.od}`,\n  `Subject: ${zakoduj(temat)}`,\n  mail.rfcMessageId ? `In-Reply-To: ${mail.rfcMessageId}` : null,\n  references ? `References: ${references}` : null,\n  'MIME-Version: 1.0',\n  'Content-Type: text/html; charset=UTF-8',\n  'Content-Transfer-Encoding: base64',\n  '',\n  Buffer.from(html, 'utf8').toString('base64')\n].filter(l => l !== null).join('\\r\\n');\n\nreturn {\n  json: {\n    messageId: mail.messageId,\n    threadId: mail.threadId,\n    kategoria: mail.kategoria,\n    jezyk: mail.jezyk,\n    pewnosc: s.pewnosc ?? 'srednia',\n    liczba_brakow: Array.isArray(s.braki) ? s.braki.length : 0,\n    czas_s: Math.round((Date.now() - mail.start) / 100) / 10,\n    tokeny: mail.tokeny + ($json.usage?.input_tokens ?? 0) + ($json.usage?.output_tokens ?? 0),\n    draft: {\n      message: {\n        raw: Buffer.from(mime, 'utf8').toString('base64url'),\n        threadId: mail.threadId\n      }\n    }\n  }\n};"
      },
